# Postgres (docker-compose usa el puerto host 5433 para no chocar con un Postgres nativo)
DATABASE_URL="postgresql://qrapi:qrapi@localhost:5433/qrapi"

# Secret de sesiones (min. 32 chars). Genera uno con:
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# SMTP para emails de verificacion (en dev: Mailpit del docker-compose, UI en http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="QrAPI <no-reply@qrapi.local>"
# SMTP_USER=""
# SMTP_PASSWORD=""

# OAuth opcional: cada proveedor se activa solo si sus dos variables existen
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Limites de la API publica (por clave)
RATE_LIMIT_PER_MINUTE="60"
RATE_LIMIT_PER_DAY="5000"
