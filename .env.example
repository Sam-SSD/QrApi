# Postgres (docker-compose maps host port 5433 to avoid clashing with a native Postgres)
DATABASE_URL="postgresql://qrapi:qrapi@localhost:5433/qrapi"

# Session secret (min. 32 chars). Generate one with:
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Public URL where the app runs: base for the docs, /r/{slug}, sitemap and metadata.
# In production set the real domain (e.g. https://qrapi.dev). Being NEXT_PUBLIC_
# it gets inlined into the bundle: changing it requires a rebuild.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# SMTP for verification emails (dev: Mailpit from docker-compose, UI at http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="QrAPI <no-reply@qrapi.local>"
# SMTP_USER=""
# SMTP_PASSWORD=""

# Email verification (default: "true"). Set to "false" to let users register
# and use the app without confirming their email; users created while off are
# stored as verified so re-enabling the flag never locks them out.
# AUTH_REQUIRE_EMAIL_VERIFICATION="true"

# Optional OAuth: each provider activates only if both of its variables exist
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Public API limits (per key)
RATE_LIMIT_PER_MINUTE="60"
RATE_LIMIT_PER_DAY="5000"

# Secret used to hash IPs in scan events (dynamic QRs)
SCAN_IP_SECRET=""
